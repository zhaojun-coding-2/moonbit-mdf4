///|
test "Previous exact age above the inclusive cap must be invalid" {
  let file = @mdf.open(@precision.age_boundary()).unwrap()
  let requests = [{ channel: 1, label: "age", policy: @mdf.Previous, }]
  let result = align_with_gap(
    file,
    requests,
    [10000000000000000.0],
    max_gap=10000000000000000.0,
  ).unwrap()
  assert_eq(result.columns()[0].values, [@mdf.Number(1.0)])
  assert_eq(result.columns()[0].valid, [false])
}

///|
test "Linear exact span above the inclusive cap must be invalid" {
  let file = @mdf.open(@precision.span_boundary()).unwrap()
  let requests = [{ channel: 1, label: "span", policy: @mdf.Linear, }]
  let result = align_with_gap(
    file,
    requests,
    [0.0],
    max_gap=10000000000000000.0,
  ).unwrap()
  assert_eq(result.columns()[0].valid, [false])
}

