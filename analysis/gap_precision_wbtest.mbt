  for i, c in cases {
    if gap_exceeds(c.0, c.1, c.2) != c.3 {
      fail(
        "duration boundary case \{i}: hi=\{c.0.reinterpret_as_uint64()} lo=\{c.1.reinterpret_as_uint64()} cap=\{c.2.reinterpret_as_uint64()} gap=\{(c.0 - c.1).reinterpret_as_uint64()}",
      )
    }
  }
}

///|
test "public gap equality, neighboring caps, observations and default alignment" {
  let age = @mdf.open(@precision.age_boundary()).unwrap()
  let held = [{ channel: 1, label: "held", policy: @mdf.Previous, }]
  let step = 0x3CB0000000000000UL.reinterpret_as_double()
  let raster = [-step, 0.0, step]
  assert_eq(
    align_with_gap(age, held, raster, max_gap=1.0).unwrap().columns()[0].valid,
    [true, true, false],
  )
  assert_eq(
    align_with_gap(age, held, [-1.0, 10000000000000002.0], max_gap=0.0)
    .unwrap()
    .columns()[0].valid,
    [true, true],
  )
  assert_eq(
    align(age, held, [10000000000000000.0]).unwrap().columns()[0].valid,
    [true],
  )
  let span = @mdf.open(@precision.unit_span()).unwrap()
  let linear = [{ channel: 1, label: "linear", policy: @mdf.Linear, }]
  assert_eq(
    align_with_gap(span, linear, [0.5], max_gap=1.0).unwrap().columns()[0].valid,
    [true],
  )
  assert_eq(
    align_with_gap(
      span,
      linear,
      [0.5],
      max_gap=0x3FEFFFFFFFFFFFFFUL.reinterpret_as_double(),
    )
    .unwrap()
    .columns()[0].valid,
    [false],
  )
  assert_eq(
    align_with_gap(
      span,
      linear,
      [0.5],
      max_gap=0x3FF0000000000001UL.reinterpret_as_double(),
    )
    .unwrap()
    .columns()[0].valid,
    [true],
  )
}
